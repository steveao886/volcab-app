{
  "name": "volcab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run --passWithNoTests",
    "lint": "oxlint",
    "parse-enex": "tsx scripts/parse-enex.ts",
    "validate-words": "tsx scripts/validate-words.ts",
    "validate-passages": "tsx scripts/validate-passages.ts",
    "validate-suggestions": "tsx scripts/validate-suggestions.ts",
    "validate-contrast-notes": "tsx scripts/validate-contrast-notes.ts",
    "validate-word-notes": "tsx scripts/validate-word-notes.ts",
    "validate-sense-groups": "tsx scripts/validate-sense-groups.ts",
    "validate-recall-sentences": "tsx scripts/validate-recall-sentences.ts",
    "validate-sentence-chunks": "tsx scripts/validate-sentence-chunks.ts",
    "validate": "npm run validate-words && npm run validate-passages && npm run validate-suggestions && npm run validate-contrast-notes && npm run validate-word-notes && npm run validate-sense-groups && npm run validate-recall-sentences && npm run validate-sentence-chunks",
    "check-live": "tsx scripts/check-live.ts",
    "chunk-worksheet": "tsx scripts/chunk-worksheet.ts"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "happy-dom": "^20.11.1",
    "oxlint": "^1.71.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  }
}
